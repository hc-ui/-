{
  "duration": 48.192,
  "duration_zh": "48.2秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 3.443,
      "text": "临时方案，住进了主干"
    },
    {
      "start": 3.443,
      "end": 6.639,
      "text": "上线那天先绕过去，说好下周再改"
    },
    {
      "start": 6.639,
      "end": 9.198,
      "text": "一周过了，绕路还在主干上"
    },
    {
      "start": 9.198,
      "end": 12.111,
      "text": "不是没人记得，是能跑就不想动"
    },
    {
      "start": 12.111,
      "end": 14.564,
      "text": "临时补丁，成了默认路径"
    },
    {
      "start": 14.564,
      "end": 17.323,
      "text": "新同学进来，只看见这条绕路"
    },
    {
      "start": 17.323,
      "end": 20.047,
      "text": "正式方案，一直停在草稿里"
    },
    {
      "start": 20.047,
      "end": 23.443,
      "text": "对照只打这一点，临时必须写搬家日"
    },
    {
      "start": 23.443,
      "end": 26.533,
      "text": "当天就记下，谁负责、哪天拆"
    },
    {
      "start": 26.533,
      "end": 29.552,
      "text": "到了那天，要么拆掉，要么升格"
    },
    {
      "start": 29.552,
      "end": 32.193,
      "text": "没搬家日的临时，就是永久"
    },
    {
      "start": 32.193,
      "end": 34.658,
      "text": "别让绕路，变成唯一的路"
    },
    {
      "start": 34.658,
      "end": 37.134,
      "text": "主干上只留能解释的路径"
    },
    {
      "start": 37.134,
      "end": 40.236,
      "text": "临时住进主干，当天开一张搬家票"
    },
    {
      "start": 40.236,
      "end": 42.288,
      "text": "到点就搬，别再拖"
    },
    {
      "start": 42.288,
      "end": 44.917,
      "text": "绕路可以过今晚，不能过冬天"
    },
    {
      "start": 44.917,
      "end": 48.192,
      "text": "没截止日期的，请当成已经住下来了"
    }
  ]
}
