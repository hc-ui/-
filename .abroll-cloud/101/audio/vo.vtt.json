{
  "duration": 47.544,
  "duration_zh": "47.5秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 2.983,
      "text": "加机器当优化"
    },
    {
      "start": 2.983,
      "end": 5.684,
      "text": "机器加上去，页面好像顺了"
    },
    {
      "start": 5.684,
      "end": 8.927,
      "text": "那不叫优化，叫把账单当止痛药"
    },
    {
      "start": 8.927,
      "end": 12.5,
      "text": "卡顿被机器暂时盖住了，根还留在原处"
    },
    {
      "start": 12.5,
      "end": 14.858,
      "text": "真流量一来，账单先炸"
    },
    {
      "start": 14.858,
      "end": 18.113,
      "text": "同一段慢查询，多开几台也照样慢"
    },
    {
      "start": 18.113,
      "end": 21.757,
      "text": "不是机器台数不够，是瓶颈根本没量过"
    },
    {
      "start": 21.757,
      "end": 24.245,
      "text": "先量清楚到底是谁在拖"
    },
    {
      "start": 24.245,
      "end": 27.04,
      "text": "再决定加机器还是改代码"
    },
    {
      "start": 27.04,
      "end": 29.34,
      "text": "量过再加，才叫买时间"
    },
    {
      "start": 29.34,
      "end": 33.373,
      "text": "没量就加，只是把同样的慢摊到更多账单上"
    },
    {
      "start": 33.373,
      "end": 36.156,
      "text": "加机器是买时间，不是买完结"
    },
    {
      "start": 36.156,
      "end": 37.866,
      "text": "对照只打这一点"
    },
    {
      "start": 37.866,
      "end": 41.12,
      "text": "慢还在原处，只是人们先看见账单"
    },
    {
      "start": 41.12,
      "end": 44.151,
      "text": "账单先降下去，不等于这个问题结束"
    },
    {
      "start": 44.151,
      "end": 45.684,
      "text": "没量过瓶颈"
    },
    {
      "start": 45.684,
      "end": 47.544,
      "text": "请当成还没优化"
    }
  ]
}
