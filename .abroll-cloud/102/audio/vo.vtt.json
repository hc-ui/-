{
  "duration": 41.616,
  "duration_zh": "41.6秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 2.925,
      "text": "评审只看格式"
    },
    {
      "start": 2.925,
      "end": 5.778,
      "text": "空格和命名都改了，像过了"
    },
    {
      "start": 5.778,
      "end": 8.467,
      "text": "格式听着认真，逻辑没人碰"
    },
    {
      "start": 8.467,
      "end": 11.026,
      "text": "不是没评审，是只审了皮"
    },
    {
      "start": 11.026,
      "end": 14.269,
      "text": "工具过了，人再过一遍等于没过"
    },
    {
      "start": 14.269,
      "end": 16.344,
      "text": "风险还在逻辑里睡觉"
    },
    {
      "start": 16.344,
      "end": 19.375,
      "text": "格式能过工具，逻辑过不了生产"
    },
    {
      "start": 19.375,
      "end": 21.309,
      "text": "评审先问三件事"
    },
    {
      "start": 21.309,
      "end": 23.149,
      "text": "边界有没有人走到"
    },
    {
      "start": 23.149,
      "end": 25.66,
      "text": "失败会不会把整条链拖垮"
    },
    {
      "start": 25.66,
      "end": 28.185,
      "text": "回退当时能不能立刻停"
    },
    {
      "start": 28.185,
      "end": 30.0,
      "text": "格式交给机器人"
    },
    {
      "start": 30.0,
      "end": 32.04,
      "text": "人只审会炸的地方"
    },
    {
      "start": 32.04,
      "end": 33.75,
      "text": "对照只打这一点"
    },
    {
      "start": 33.75,
      "end": 36.863,
      "text": "改完空格，不等于这一次评审结束"
    },
    {
      "start": 36.863,
      "end": 39.092,
      "text": "皮过了，不等于能上线"
    },
    {
      "start": 39.092,
      "end": 41.616,
      "text": "逻辑没审，请当成还没过"
    }
  ]
}
