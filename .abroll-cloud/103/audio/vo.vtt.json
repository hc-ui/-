{
  "duration": 43.392,
  "duration_zh": "43.4秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 3.113,
      "text": "一句只讲一件事"
    },
    {
      "start": 3.113,
      "end": 5.59,
      "text": "一句口播里硬塞两件事"
    },
    {
      "start": 5.59,
      "end": 8.019,
      "text": "听众往往只会记住后一件"
    },
    {
      "start": 8.019,
      "end": 10.118,
      "text": "前一件常常当没说"
    },
    {
      "start": 10.118,
      "end": 14.116,
      "text": "不是听的人记性差，是你把两个意思挤进同一句"
    },
    {
      "start": 14.116,
      "end": 16.45,
      "text": "逗号后面还藏着第二点"
    },
    {
      "start": 16.45,
      "end": 18.762,
      "text": "听的人只能抓住后半刀"
    },
    {
      "start": 18.762,
      "end": 20.601,
      "text": "一句只办一件事"
    },
    {
      "start": 20.601,
      "end": 22.571,
      "text": "一个意思，一个动作"
    },
    {
      "start": 22.571,
      "end": 25.33,
      "text": "要讲下一件，必须先切一刀"
    },
    {
      "start": 25.33,
      "end": 28.243,
      "text": "先把这一句说完，再另开下一句"
    },
    {
      "start": 28.243,
      "end": 30.566,
      "text": "下次写稿先把点数清"
    },
    {
      "start": 30.566,
      "end": 32.7,
      "text": "一句里只留一个动作"
    },
    {
      "start": 32.7,
      "end": 36.333,
      "text": "看见一句里还藏着第二点，当场就拆开"
    },
    {
      "start": 36.333,
      "end": 38.054,
      "text": "拆开才算讲过"
    },
    {
      "start": 38.054,
      "end": 39.764,
      "text": "对照只打这一点"
    },
    {
      "start": 39.764,
      "end": 43.392,
      "text": "塞在同一句里的前一件，请直接当成没说"
    }
  ]
}
