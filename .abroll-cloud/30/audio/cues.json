[
  {
    "text": "大家好",
    "start": 0.0,
    "end": 1.3401041
  },
  {
    "text": "只改一条定律",
    "start": 1.3401041,
    "end": 3.0078125
  },
  {
    "text": "水的表面张力乘一百",
    "start": 3.0078125,
    "end": 5.5078126
  },
  {
    "text": "先看正常，雨砸伞就炸开",
    "start": 5.5078126,
    "end": 8.372396
  },
  {
    "text": "再看反常，砸下去压个坑再弹回来",
    "start": 8.372396,
    "end": 11.9010419
  },
  {
    "text": "落地不飞溅，像凝胶球",
    "start": 11.9010419,
    "end": 14.6223961
  },
  {
    "text": "落叶压出水洼一个坑，不沉",
    "start": 14.6223961,
    "end": 17.682292
  },
  {
    "text": "水面整体往上鼓，高出边缘",
    "start": 17.682292,
    "end": 20.7812504
  },
  {
    "text": "整条街的水洼，全是凸的",
    "start": 20.7812504,
    "end": 23.64
  }
