[
  {
    "text": "大家好",
    "start": 0.0,
    "end": 1.3401041
  },
  {
    "text": "只改一条定律",
    "start": 1.3401041,
    "end": 3.0078125
  },
  {
    "text": "假想定律：被盯着越久，东西越重",
    "start": 3.0078125,
    "end": 6.5625001
  },
  {
    "text": "盯着苹果，苹果压进桌面",
    "start": 6.5625001,
    "end": 9.3619793
  },
  {
    "text": "围观的东西开始下沉",
    "start": 9.3619793,
    "end": 11.7838544
  },
  {
    "text": "镜子里的自己越来越重",
    "start": 11.7838544,
    "end": 14.4010419
  },
  {
    "text": "越有名的展品陷得越深",
    "start": 14.4010419,
    "end": 16.8880212
  },
  {
    "text": "最有名的那幅画，整幅沉进地板，只露画框上沿",
    "start": 16.8880212,
    "end": 21.984014
  }
