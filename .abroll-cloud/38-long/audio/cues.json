[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 5.153,
    "text": "观众分不清，你是改了物理，还是AI画错"
  },
  {
    "start": 5.153,
    "end": 8.526,
    "text": "一颗不融进水的球，看起来就像玻璃珠"
  },
  {
    "start": 8.526,
    "end": 11.002,
    "text": "微妙对照会被当成穿帮"
  },
  {
    "start": 11.002,
    "end": 13.314,
    "text": "同一滴水，三种读法"
  },
  {
    "start": 13.314,
    "end": 15.849,
    "text": "正常飞溅，观众认得出水"
  },
  {
    "start": 15.849,
    "end": 18.538,
    "text": "微妙玻璃珠，看起来像穿帮"
  },
  {
    "start": 18.538,
    "end": 21.38,
    "text": "整街水洼鼓起，才不像穿帮"
  },
  {
    "start": 21.38,
    "end": 22.866,
    "text": "抽卡救不了"
  },
  {
    "start": 22.866,
    "end": 25.507,
    "text": "再抽一张，还是同一颗假珠"
  },
  {
    "start": 25.507,
    "end": 27.713,
    "text": "物理和画错叠在一起"
  },
  {
    "start": 27.713,
    "end": 30.295,
    "text": "撕不开，观众只会怪生成"
  },
  {
    "start": 30.295,
    "end": 32.406,
    "text": "先给正常再给反常"
  },
  {
    "start": 32.406,
    "end": 34.682,
    "text": "片头写清只改这一条"
  },
  {
    "start": 34.682,
    "end": 36.981,
    "text": "开头字卡宣告改了哪条"
  },
  {
    "start": 36.981,
    "end": 38.998,
    "text": "别让观众猜你画崩了"
  },
  {
    "start": 38.998,
    "end": 41.792,
    "text": "尺度放大，大到不可能是穿帮"
  },
  {
    "start": 41.792,
    "end": 44.472,
    "text": "教训当题目，不是再抽一张"
  }
]
