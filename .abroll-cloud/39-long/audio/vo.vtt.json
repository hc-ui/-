{
  "duration": 43.128,
  "duration_zh": "43.1秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 3.915,
      "text": "推不出来的酷画面，一律删掉"
    },
    {
      "start": 3.915,
      "end": 5.684,
      "text": "不是画面不够酷"
    },
    {
      "start": 5.684,
      "end": 8.078,
      "text": "是它连不上你改的那条定律"
    },
    {
      "start": 8.078,
      "end": 10.059,
      "text": "每期结构先锁死"
    },
    {
      "start": 10.059,
      "end": 12.583,
      "text": "改一条定律，推出三个后果"
    },
    {
      "start": 12.583,
      "end": 15.33,
      "text": "最后一个后果，才拿来当回报"
    },
    {
      "start": 15.33,
      "end": 17.606,
      "text": "想到五个，先砍到三个"
    },
    {
      "start": 17.606,
      "end": 20.295,
      "text": "留下最反直觉、最好拍的"
    },
    {
      "start": 20.295,
      "end": 22.948,
      "text": "好看但推不出来的，先划掉"
    },
    {
      "start": 22.948,
      "end": 25.696,
      "text": "从改的那条定律，拉一根箭头"
    },
    {
      "start": 25.696,
      "end": 28.031,
      "text": "能连上的后果，才留下"
    },
    {
      "start": 28.031,
      "end": 30.896,
      "text": "连不上的酷图，观众一律当假"
    },
    {
      "start": 30.896,
      "end": 33.278,
      "text": "假就出在推不出来的地方"
    },
    {
      "start": 33.278,
      "end": 35.943,
      "text": "回报镜只放大最后一个后果"
    },
    {
      "start": 35.943,
      "end": 38.231,
      "text": "别再加一张炫的空镜头"
    },
    {
      "start": 38.231,
      "end": 40.66,
      "text": "酷画面推不出来，就删"
    },
    {
      "start": 40.66,
      "end": 43.128,
      "text": "删掉，比硬留假镜头强"
    }
  ]
}
