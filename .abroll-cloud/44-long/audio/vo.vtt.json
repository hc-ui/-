{
  "duration": 45.24,
  "duration_zh": "45.2秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 3.16,
      "text": "忙完一天却没推进"
    },
    {
      "start": 3.16,
      "end": 6.05,
      "text": "日历划满了，推进栏却是空的"
    },
    {
      "start": 6.05,
      "end": 8.939,
      "text": "不是你不够努力，是整天都在反应"
    },
    {
      "start": 8.939,
      "end": 12.618,
      "text": "回消息、救火、插队，正事被挤走"
    },
    {
      "start": 12.618,
      "end": 14.517,
      "text": "忙的是别人的紧急"
    },
    {
      "start": 14.517,
      "end": 16.828,
      "text": "不是自己能留下的痕迹"
    },
    {
      "start": 16.828,
      "end": 19.788,
      "text": "今天只留一件能留下痕迹的动作"
    },
    {
      "start": 19.788,
      "end": 22.807,
      "text": "写下这一件必须推进，不是回复"
    },
    {
      "start": 22.807,
      "end": 25.896,
      "text": "文档、代码、决定，才算痕迹"
    },
    {
      "start": 25.896,
      "end": 28.561,
      "text": "一件动了，比十件反应值钱"
    },
    {
      "start": 28.561,
      "end": 30.649,
      "text": "临时插入先问明天"
    },
    {
      "start": 30.649,
      "end": 33.573,
      "text": "插进来的先问，能不能放到明天"
    },
    {
      "start": 33.573,
      "end": 36.238,
      "text": "今天只保这一件，别的先让路"
    },
    {
      "start": 36.238,
      "end": 38.797,
      "text": "先问明天，再决定让不让路"
    },
    {
      "start": 38.797,
      "end": 40.755,
      "text": "动了，今天才算过"
    },
    {
      "start": 40.755,
      "end": 42.771,
      "text": "反应再忙也不算过"
    },
    {
      "start": 42.771,
      "end": 45.24,
      "text": "留下痕迹，今天才算过"
    }
  ]
}
