{
  "duration": 46.392,
  "cues": [
    {
      "start": 0.0,
      "end": 1.393,
      "text": "大家好"
    },
    {
      "start": 1.393,
      "end": 4.069,
      "text": "会议写了开始，没写结束"
    },
    {
      "start": 4.069,
      "end": 6.582,
      "text": "开始时间人人都填"
    },
    {
      "start": 6.582,
      "end": 8.829,
      "text": "结束时间常常空着"
    },
    {
      "start": 8.829,
      "end": 11.689,
      "text": "没有结束时间，就会一直聊"
    },
    {
      "start": 11.689,
      "end": 13.391,
      "text": "不是议题太多"
    },
    {
      "start": 13.391,
      "end": 16.117,
      "text": "是没人知道什么时候能走"
    },
    {
      "start": 16.117,
      "end": 19.215,
      "text": "没写散会点，就没人敢先走"
    },
    {
      "start": 19.215,
      "end": 22.912,
      "text": "日历上只有开始，会议就变成聊天"
    },
    {
      "start": 22.912,
      "end": 25.771,
      "text": "预约的时候，先写下散会点"
    },
    {
      "start": 25.771,
      "end": 28.71,
      "text": "开始九点，结束九点四十"
    },
    {
      "start": 28.71,
      "end": 30.878,
      "text": "四十分钟够用就开"
    },
    {
      "start": 30.878,
      "end": 33.324,
      "text": "不够用，就拆成两次"
    },
    {
      "start": 33.324,
      "end": 35.851,
      "text": "到点没有结论，就先散"
    },
    {
      "start": 35.851,
      "end": 38.457,
      "text": "结论另约，不现场续摊"
    },
    {
      "start": 38.457,
      "end": 40.559,
      "text": "散会不等于失败"
    },
    {
      "start": 40.559,
      "end": 43.032,
      "text": "没写结束，才是失败"
    },
    {
      "start": 43.032,
      "end": 46.392,
      "text": "写下散会点，会议才结束得了"
    }
  ]
}
