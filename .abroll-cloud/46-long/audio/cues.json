[
  {
    "start": 0.0,
    "end": 1.365,
    "text": "大家好"
  },
  {
    "start": 1.365,
    "end": 3.919,
    "text": "杂务按六十分及格交付"
  },
  {
    "start": 3.919,
    "end": 5.365,
    "text": "不是偷懒"
  },
  {
    "start": 5.365,
    "end": 7.513,
    "text": "是把力气留给正事"
  },
  {
    "start": 7.513,
    "end": 10.677,
    "text": "行政杂务，当成换工位的租金"
  },
  {
    "start": 10.677,
    "end": 12.461,
    "text": "租金交完就行"
  },
  {
    "start": 12.461,
    "end": 14.128,
    "text": "别交成主业"
  },
  {
    "start": 14.128,
    "end": 17.461,
    "text": "工位卫生，收发快递，盖章跑腿"
  },
  {
    "start": 17.461,
    "end": 19.674,
    "text": "这些都按六十分做"
  },
  {
    "start": 19.674,
    "end": 22.435,
    "text": "标准只有一条，不出差错"
  },
  {
    "start": 22.435,
    "end": 25.352,
    "text": "六十分就过，别追求九十分"
  },
  {
    "start": 25.352,
    "end": 28.086,
    "text": "多一分，就少一分给课题"
  },
  {
    "start": 28.086,
    "end": 31.042,
    "text": "做完即止，清单勾上就停"
  },
  {
    "start": 31.042,
    "end": 33.503,
    "text": "别把卫生做成作品集"
  },
  {
    "start": 33.503,
    "end": 35.482,
    "text": "别在杂务上评优"
  },
  {
    "start": 35.482,
    "end": 39.023,
    "text": "评优那分别投，情绪也别跟进去"
  },
  {
    "start": 39.023,
    "end": 40.898,
    "text": "这不是你的战场"
  },
  {
    "start": 40.898,
    "end": 44.496,
    "text": "过了就走，把满分留给该满分的事"
  }
]
