{
  "duration": 48.36,
  "duration_zh": "48.4秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 4.469,
      "text": "远程实习，人在工位，活在线上"
    },
    {
      "start": 4.469,
      "end": 7.406,
      "text": "不是把人挪出合肥去外地实习"
    },
    {
      "start": 7.406,
      "end": 9.976,
      "text": "是人坐着，活挪到线上做"
    },
    {
      "start": 9.976,
      "end": 12.689,
      "text": "杂活来了按时应，做完即止"
    },
    {
      "start": 12.689,
      "end": 15.39,
      "text": "人不用搬走，工位得留人"
    },
    {
      "start": 15.39,
      "end": 18.137,
      "text": "工位空了被查岗，才最危险"
    },
    {
      "start": 18.137,
      "end": 20.932,
      "text": "第一步，双屏先在工位摆开"
    },
    {
      "start": 20.932,
      "end": 23.939,
      "text": "左边跑实验仿真，曲线还在走"
    },
    {
      "start": 23.939,
      "end": 26.887,
      "text": "右边接线上软件或算法项目"
    },
    {
      "start": 26.887,
      "end": 29.953,
      "text": "考勤在工位拿，履历在线上攒"
    },
    {
      "start": 29.953,
      "end": 32.913,
      "text": "第二步，合肥本地实习先灰掉"
    },
    {
      "start": 32.913,
      "end": 36.026,
      "text": "等研二下或研三再探本地岗位"
    },
    {
      "start": 36.026,
      "end": 38.491,
      "text": "专利或论文初稿先锁定"
    },
    {
      "start": 38.491,
      "end": 41.285,
      "text": "杂活交接后再谈本地实习"
    },
    {
      "start": 41.285,
      "end": 43.868,
      "text": "现在只做这一条，别两头跑"
    },
    {
      "start": 43.868,
      "end": 46.215,
      "text": "考勤和履历要一起拿"
    },
    {
      "start": 46.215,
      "end": 48.36,
      "text": "人坐着，活在线上"
    }
  ]
}
