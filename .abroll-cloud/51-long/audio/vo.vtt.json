{
  "duration": 49.056,
  "duration_zh": "49.1秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 4.21,
      "text": "Agent是第二技能树，不是主线"
    },
    {
      "start": 4.21,
      "end": 6.639,
      "text": "不是当前唯一的职业主线"
    },
    {
      "start": 6.639,
      "end": 9.705,
      "text": "主树先长控制、机器人和智能"
    },
    {
      "start": 9.705,
      "end": 12.983,
      "text": "副树是Agent，先淡着放在旁边"
    },
    {
      "start": 12.983,
      "end": 15.79,
      "text": "副线可以慢慢攒语言基础和接口"
    },
    {
      "start": 15.79,
      "end": 18.502,
      "text": "再攒工具调用，不要一次铺开"
    },
    {
      "start": 18.502,
      "end": 21.91,
      "text": "再往后才是检索增强、协议和技能"
    },
    {
      "start": 21.91,
      "end": 24.528,
      "text": "长期可以看机器人加智能体"
    },
    {
      "start": 24.528,
      "end": 27.501,
      "text": "当前别因此同时开过多学习线"
    },
    {
      "start": 27.501,
      "end": 30.436,
      "text": "现在箭头只指基础语言这一块"
    },
    {
      "start": 30.436,
      "end": 33.302,
      "text": "侧牌堆在旁边，先别上主桌"
    },
    {
      "start": 33.302,
      "end": 35.755,
      "text": "检索和协议先不上主桌"
    },
    {
      "start": 35.755,
      "end": 38.196,
      "text": "独立小项目还没做出来之前"
    },
    {
      "start": 38.196,
      "end": 40.79,
      "text": "这些只保持兴趣，不当主线"
    },
    {
      "start": 40.79,
      "end": 43.385,
      "text": "不是把副线抬成当前主线"
    },
    {
      "start": 43.385,
      "end": 46.226,
      "text": "主线先长控制和机器人这一棵"
    },
    {
      "start": 46.226,
      "end": 49.056,
      "text": "第二技能树可以攒，先别抢戏"
    }
  ]
}
