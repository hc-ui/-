[
  {
    "start": 0.0,
    "end": 1.365,
    "text": "大家好"
  },
  {
    "start": 1.365,
    "end": 3.62,
    "text": "别把反转写进标题"
  },
  {
    "start": 3.62,
    "end": 6.797,
    "text": "结局提前说破，后面没有悬念"
  },
  {
    "start": 6.797,
    "end": 8.62,
    "text": "不是标题字多"
  },
  {
    "start": 8.62,
    "end": 11.029,
    "text": "是你先把结尾交出去了"
  },
  {
    "start": 11.029,
    "end": 14.583,
    "text": "观众看见原来他没死，后面不用看"
  },
  {
    "start": 14.583,
    "end": 16.615,
    "text": "悬念已经被掏空"
  },
  {
    "start": 16.615,
    "end": 19.088,
    "text": "封面只问谁动了证据"
  },
  {
    "start": 19.088,
    "end": 20.977,
    "text": "别写凶手是他"
  },
  {
    "start": 20.977,
    "end": 22.891,
    "text": "标题只留冲突"
  },
  {
    "start": 22.891,
    "end": 24.727,
    "text": "反转留给片子"
  },
  {
    "start": 24.727,
    "end": 28.372,
    "text": "写完标题，把结局那几个字圈出来"
  },
  {
    "start": 28.372,
    "end": 30.872,
    "text": "整段挪走，挪到片尾"
  },
  {
    "start": 30.872,
    "end": 33.555,
    "text": "挪到片尾，才有人看到底"
  },
  {
    "start": 33.555,
    "end": 36.094,
    "text": "禁的是剧透自己的结尾"
  },
  {
    "start": 36.094,
    "end": 38.047,
    "text": "不是预告下一期"
  },
  {
    "start": 38.047,
    "end": 41.146,
    "text": "对照一下，剧透标题点开就空"
  },
  {
    "start": 41.146,
    "end": 44.304,
    "text": "标题只问冲突，片子才给答案"
  }
]
