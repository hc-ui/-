[
  {
    "start": 0.0,
    "end": 1.365,
    "text": "大家好"
  },
  {
    "start": 1.365,
    "end": 4.57,
    "text": "提问后面留半拍，别急着自己接"
  },
  {
    "start": 4.57,
    "end": 9.27,
    "text": "问完立刻自答，钩子还没咬住，人已经准备滑走"
  },
  {
    "start": 9.27,
    "end": 13.268,
    "text": "稿子写成为什么因为，问号后面连着自己答"
  },
  {
    "start": 13.268,
    "end": 16.823,
    "text": "人还没把问号接住，答案已经砸下来"
  },
  {
    "start": 16.823,
    "end": 20.091,
    "text": "他来不及点头，手指已经滑走"
  },
  {
    "start": 20.091,
    "end": 22.891,
    "text": "问句落地，停半拍再给答案"
  },
  {
    "start": 22.891,
    "end": 27.747,
    "text": "正确写法是为什么，先换行，空半拍，再写因为"
  },
  {
    "start": 27.747,
    "end": 31.458,
    "text": "口播在问号后面停，字幕也跟着停"
  },
  {
    "start": 31.458,
    "end": 34.362,
    "text": "写完口播，在问号后面留空"
  },
  {
    "start": 34.362,
    "end": 39.115,
    "text": "半拍不是冷场，是让钩子先咬住，再把答案递过去"
  },
  {
    "start": 39.115,
    "end": 42.288,
    "text": "问完先停，他接住了再给答案"
  }
]
