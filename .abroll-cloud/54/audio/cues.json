[
  {
    "start": 0.0,
    "end": 1.365,
    "text": "大家好"
  },
  {
    "start": 1.365,
    "end": 3.464,
    "text": "别用你肯定知道开头"
  },
  {
    "start": 3.464,
    "end": 6.927,
    "text": "这三个字一出，对方已经准备抬杠"
  },
  {
    "start": 6.927,
    "end": 8.802,
    "text": "他不是在听你讲"
  },
  {
    "start": 8.802,
    "end": 10.898,
    "text": "是在找你哪里说错"
  },
  {
    "start": 10.898,
    "end": 15.573,
    "text": "你越补一句这个很基础，他越觉得被你踩了一脚"
  },
  {
    "start": 15.573,
    "end": 18.125,
    "text": "开场不要审对方懂不懂"
  },
  {
    "start": 18.125,
    "end": 20.846,
    "text": "口播里先把对方当同事"
  },
  {
    "start": 20.846,
    "end": 22.93,
    "text": "不要一上来就上课"
  },
  {
    "start": 22.93,
    "end": 25.898,
    "text": "直接给一个对方能核对的事实"
  },
  {
    "start": 25.898,
    "end": 28.749,
    "text": "或者给一个马上能做的动作"
  },
  {
    "start": 28.749,
    "end": 31.094,
    "text": "事实要能当场核对"
  },
  {
    "start": 31.094,
    "end": 33.359,
    "text": "动作要能马上动手"
  },
  {
    "start": 33.359,
    "end": 36.758,
    "text": "写完开场，把你肯定知道整句删掉"
  },
  {
    "start": 36.758,
    "end": 39.193,
    "text": "连同这个很基础一起删"
  },
  {
    "start": 39.193,
    "end": 42.201,
    "text": "删完务必出声把第一句读一遍"
  },
  {
    "start": 42.201,
    "end": 45.026,
    "text": "第一句站不住，后面都白讲"
  },
  {
    "start": 45.026,
    "end": 48.264,
    "text": "第一句站得住，人才会留下来听"
  }
]
