[
  {
    "start": 0.0,
    "end": 1.453,
    "text": "大家好"
  },
  {
    "start": 1.453,
    "end": 3.556,
    "text": "别在字幕里加注释"
  },
  {
    "start": 3.556,
    "end": 7.847,
    "text": "很多人写字幕，喜欢在句子后面加一括号"
  },
  {
    "start": 7.847,
    "end": 11.764,
    "text": "括号一出来，听众当补充，直接跳过"
  },
  {
    "start": 11.764,
    "end": 15.889,
    "text": "他看见那对括号，就当这句话可有可无"
  },
  {
    "start": 15.889,
    "end": 19.75,
    "text": "该记住的结论，被括号里的解释冲掉了"
  },
  {
    "start": 19.75,
    "end": 23.611,
    "text": "这不是在帮人理解，是在教人略过"
  },
  {
    "start": 23.611,
    "end": 26.806,
    "text": "括号是作者的旁白，不是正文"
  },
  {
    "start": 26.806,
    "end": 28.917,
    "text": "字幕只跟口播"
  },
  {
    "start": 28.917,
    "end": 32.542,
    "text": "口里没说的字，幕上就不要出现"
  },
  {
    "start": 32.542,
    "end": 37.375,
    "text": "要补充的例子、出处、反例，注释放到图上"
  },
  {
    "start": 37.375,
    "end": 41.097,
    "text": "角落钉一张小卡，别塞进字幕括号"
  },
  {
    "start": 41.097,
    "end": 44.111,
    "text": "写字幕的时候，先跟读一遍"
  },
  {
    "start": 44.111,
    "end": 46.972,
    "text": "跟不上口的字，就是注释"
  },
  {
    "start": 46.972,
    "end": 49.776,
    "text": "写完字幕，把括号删掉"
  }
]
