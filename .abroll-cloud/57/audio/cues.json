[
  {
    "start": 0.0,
    "end": 1.453,
    "text": "大家好"
  },
  {
    "start": 1.453,
    "end": 6.778,
    "text": "知识口播最容易胖的，不是字多，是一屏同时打三枪"
  },
  {
    "start": 6.778,
    "end": 9.944,
    "text": "三枪一起出，一枪都没进"
  },
  {
    "start": 9.944,
    "end": 13.194,
    "text": "观众眼睛只能停在一个对照上"
  },
  {
    "start": 13.194,
    "end": 16.347,
    "text": "左边是错法，右边是做法"
  },
  {
    "start": 16.347,
    "end": 19.097,
    "text": "一张对照卡，只打一个点"
  },
  {
    "start": 19.097,
    "end": 22.208,
    "text": "信息图不是目录墙，是反差"
  },
  {
    "start": 22.208,
    "end": 27.11,
    "text": "目录墙像五条建议叠在一起，他一张都带不走"
  },
  {
    "start": 27.11,
    "end": 31.375,
    "text": "你要他记住的，不是五条建议，是那一对对错"
  },
  {
    "start": 31.375,
    "end": 34.444,
    "text": "多出来的点，先别上这张卡"
  },
  {
    "start": 34.444,
    "end": 36.389,
    "text": "一屏只留一对"
  },
  {
    "start": 36.389,
    "end": 39.069,
    "text": "第二对会把第一对冲掉"
  },
  {
    "start": 39.069,
    "end": 41.611,
    "text": "多的点，下一张再打"
  },
  {
    "start": 41.611,
    "end": 45.625,
    "text": "先画左右两边，再写要他带走的那一句"
  },
  {
    "start": 45.625,
    "end": 49.536,
    "text": "下回做卡片，先画对照，再写金句"
  }
