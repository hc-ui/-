[
  {
    "start": 0.0,
    "end": 1.365,
    "text": "大家好"
  },
  {
    "start": 1.365,
    "end": 3.815,
    "text": "周末补觉，周一更困"
  },
  {
    "start": 3.815,
    "end": 7.266,
    "text": "你以为觉补回来了，身体不认这笔账"
  },
  {
    "start": 7.266,
    "end": 11.484,
    "text": "不是没睡够，是节奏乱了，钟已经被拨走"
  },
  {
    "start": 11.484,
    "end": 15.742,
    "text": "生物钟认固定的起床点，不认周末睡到中午"
  },
  {
    "start": 15.742,
    "end": 18.633,
    "text": "起床点一漂，整周都会困"
  },
  {
    "start": 18.633,
    "end": 21.458,
    "text": "睡眠债不能周末一次还清"
  },
  {
    "start": 21.458,
    "end": 25.299,
    "text": "晚睡两小时，不是多睡两小时就能抹平"
  },
  {
    "start": 25.299,
    "end": 28.789,
    "text": "补回来的是困意，补不回来的是节律"
  },
  {
    "start": 28.789,
    "end": 32.838,
    "text": "固定起床，比补觉更有用，先锁起床点"
  },
  {
    "start": 32.838,
    "end": 36.146,
    "text": "起床点锁死，睡觉点才跟得上"
  },
  {
    "start": 36.146,
    "end": 39.753,
    "text": "今晚少刷一条，比周末睡到中午值"
  },
  {
    "start": 39.753,
    "end": 43.248,
    "text": "少欠一笔，比周末一次还清靠谱"
  }
]
