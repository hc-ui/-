[
  {
    "start": 0.0,
    "end": 1.365,
    "text": "大家好"
  },
  {
    "start": 1.365,
    "end": 3.763,
    "text": "试点成功，却推不开"
  },
  {
    "start": 3.763,
    "end": 6.536,
    "text": "试点跑通了，一推广就死"
  },
  {
    "start": 6.536,
    "end": 10.273,
    "text": "不是办法错了，是成功条件没跟着走"
  },
  {
    "start": 10.273,
    "end": 14.505,
    "text": "那间屋子里有人盯、有人会、有现成工具"
  },
  {
    "start": 14.505,
    "end": 17.917,
    "text": "换一间屋子，人走了，手册是空的"
  },
  {
    "start": 17.917,
    "end": 21.797,
    "text": "你以为复制的是方法，其实复制的是运气"
  },
  {
    "start": 21.797,
    "end": 24.388,
    "text": "试点过了，不等于能铺开"
  },
  {
    "start": 24.388,
    "end": 27.148,
    "text": "第一间屋子的成功，带不走"
  },
  {
    "start": 27.148,
    "end": 29.753,
    "text": "先写下试点为什么能成"
  },
  {
    "start": 29.753,
    "end": 33.229,
    "text": "三条条件，缺一条就先别硬推"
  },
  {
    "start": 33.229,
    "end": 36.745,
    "text": "人、手册、工具，都要能搬家"
  },
  {
    "start": 36.745,
    "end": 40.508,
    "text": "下一间屋子对不上，就改条件，别改口号"
  },
  {
    "start": 40.508,
    "end": 43.515,
    "text": "庆祝试点，不等于交付推广"
  },
  {
    "start": 43.515,
    "end": 45.864,
    "text": "扩不开，就先别铺"
  }
]
