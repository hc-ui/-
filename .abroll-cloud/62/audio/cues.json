[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 3.455,
    "text": "再优化一下，没有验收"
  },
  {
    "start": 3.455,
    "end": 6.274,
    "text": "不是人不够认真，是标准没立"
  },
  {
    "start": 6.274,
    "end": 8.361,
    "text": "这句话本身没有终点"
  },
  {
    "start": 8.361,
    "end": 10.566,
    "text": "优化可以永远再来一轮"
  },
  {
    "start": 10.566,
    "end": 12.759,
    "text": "没有验收，就没有做完"
  },
  {
    "start": 12.759,
    "end": 15.436,
    "text": "感觉还能更好，那也不算过"
  },
  {
    "start": 15.436,
    "end": 18.373,
    "text": "第一步，开工先写下什么叫做过"
  },
  {
    "start": 18.373,
    "end": 20.79,
    "text": "三条能打勾的标准就够用"
  },
  {
    "start": 20.79,
    "end": 23.455,
    "text": "谁来点头，名字也要先写上"
  },
  {
    "start": 23.455,
    "end": 25.802,
    "text": "第二步，一轮只改一条"
  },
  {
    "start": 25.802,
    "end": 27.913,
    "text": "不准顺手再加新功能"
  },
  {
    "start": 27.913,
    "end": 30.448,
    "text": "改完对照标准，过了就停手"
  },
  {
    "start": 30.448,
    "end": 32.807,
    "text": "不过就只改没过的那一条"
  },
  {
    "start": 32.807,
    "end": 35.377,
    "text": "第三步，验收人当场签字"
  },
  {
    "start": 35.377,
    "end": 38.054,
    "text": "没有人点头，这轮优化不算数"
  },
  {
    "start": 38.054,
    "end": 40.825,
    "text": "下次开口别再说再优化一下"
  },
  {
    "start": 40.825,
    "end": 43.632,
    "text": "没有验收的优化，请当成没立"
  }
