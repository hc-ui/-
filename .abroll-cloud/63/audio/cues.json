[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 3.019,
    "text": "排期只有乐观数"
  },
  {
    "start": 3.019,
    "end": 5.79,
    "text": "表上只写最快能做完的那天"
  },
  {
    "start": 5.79,
    "end": 9.399,
    "text": "那是一切顺利的数字，不是能守住的数字"
  },
  {
    "start": 9.399,
    "end": 13.726,
    "text": "接口晚一天，评审多一轮，人一请假，那天就没了"
  },
  {
    "start": 13.726,
    "end": 16.698,
    "text": "表上的日子还在，活已经对不上"
  },
  {
    "start": 16.698,
    "end": 19.858,
    "text": "不是执行差，是你把晴天当成了天气"
  },
  {
    "start": 19.858,
    "end": 22.087,
    "text": "乐观数像出门不带伞"
  },
  {
    "start": 22.087,
    "end": 24.835,
    "text": "你按它对外承诺，迟到的是你"
  },
  {
    "start": 24.835,
    "end": 27.712,
    "text": "别人按那天来等，等来的是延期"
  },
  {
    "start": 27.712,
    "end": 30.236,
    "text": "正确做法，排期写两格"
  },
  {
    "start": 30.236,
    "end": 32.028,
    "text": "一格是顺利能到"
  },
  {
    "start": 32.028,
    "end": 33.915,
    "text": "一格是出岔还能到"
  },
  {
    "start": 33.915,
    "end": 36.38,
    "text": "对外只报能守住的那格"
  },
  {
    "start": 36.38,
    "end": 39.41,
    "text": "别把内部的最快，写成对外的截止"
  },
  {
    "start": 39.41,
    "end": 42.736,
    "text": "写完排期，把只有一格的乐观数划掉"
  },
  {
    "start": 42.736,
    "end": 44.808,
    "text": "留下带伞的那一天"
  }
]
