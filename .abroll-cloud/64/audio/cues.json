[
  {
    "start": 0.0,
    "end": 1.253,
    "text": "大家好"
  },
  {
    "start": 1.253,
    "end": 3.858,
    "text": "点一次菜单，成绩册就空了"
  },
  {
    "start": 3.858,
    "end": 7.561,
    "text": "不是字典坏了，是空字典建在了循环里面"
  },
  {
    "start": 7.561,
    "end": 11.982,
    "text": "空花括号写进了循环里头，每进一轮就重建一次"
  },
  {
    "start": 11.982,
    "end": 15.553,
    "text": "每选一次菜单，整本成绩被揉成白纸"
  },
  {
    "start": 15.553,
    "end": 19.412,
    "text": "容器的出生地点，决定它能不能活过下一轮"
  },
  {
    "start": 19.412,
    "end": 22.096,
    "text": "循环外建，才能活过下一轮"
  },
  {
    "start": 22.096,
    "end": 25.307,
    "text": "循环里建，每进一次门就重建一次"
  },
  {
    "start": 25.307,
    "end": 28.291,
    "text": "空字典在门外建，别在门里重建"
  },
  {
    "start": 28.291,
    "end": 31.646,
    "text": "门外建一次，门里只读写，不再新建"
  },
  {
    "start": 31.646,
    "end": 34.737,
    "text": "先让菜单能退出，再增和列出"
  },
  {
    "start": 34.737,
    "end": 38.14,
    "text": "先把出生地点写对，别急着加新语法"
  },
  {
    "start": 38.14,
    "end": 41.555,
    "text": "对照只打这一点：门外建，门里不重建"
  },
  {
    "start": 41.555,
    "end": 44.647,
    "text": "写循环之前，先问字典出生在哪"
  },
  {
    "start": 44.647,
    "end": 48.783,
    "text": "出生在门外还能留下，出生在门里下一轮就是空的"
  }
]
