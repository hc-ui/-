[
  {
    "start": 0.0,
    "end": 1.453,
    "text": "大家好"
  },
  {
    "start": 1.453,
    "end": 4.264,
    "text": "口头同步，被当成过结论"
  },
  {
    "start": 4.264,
    "end": 7.5,
    "text": "走廊对过一句，群里回了个好"
  },
  {
    "start": 7.5,
    "end": 10.194,
    "text": "这不叫定了，这叫说过"
  },
  {
    "start": 10.194,
    "end": 13.611,
    "text": "说过的话，每人记住的版本不一样"
  },
  {
    "start": 13.611,
    "end": 16.792,
    "text": "你以为拍了板，他以为只是聊聊"
  },
  {
    "start": 16.792,
    "end": 20.736,
    "text": "第二天各做各的，才发现根本没定过"
  },
  {
    "start": 20.736,
    "end": 25.583,
    "text": "口头同步最容易空的，不是话少，是没留下字"
  },
  {
    "start": 25.583,
    "end": 28.139,
    "text": "同步完立刻写下三行"
  },
  {
    "start": 28.139,
    "end": 31.375,
    "text": "谁同意，定了什么，没定什么"
  },
  {
    "start": 31.375,
    "end": 34.25,
    "text": "写完发出去，让对方能改"
  },
  {
    "start": 34.25,
    "end": 37.097,
    "text": "对方没回，就不算对齐"
  },
  {
    "start": 37.097,
    "end": 39.971,
    "text": "没写成字，就不算结论"
  },
  {
    "start": 39.971,
    "end": 43.333,
    "text": "别把口头同步，直接写进待办"
  },
  {
    "start": 43.333,
    "end": 46.032,
    "text": "先留下字，再当结论"
  }
]
