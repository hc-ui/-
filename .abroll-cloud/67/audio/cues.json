[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 2.771,
    "text": "置顶了也不看"
  },
  {
    "start": 2.771,
    "end": 5.932,
    "text": "你以为钉在最顶上，他就一定会打开"
  },
  {
    "start": 5.932,
    "end": 8.856,
    "text": "置顶只是一个位置，不是一次阅读"
  },
  {
    "start": 8.856,
    "end": 12.347,
    "text": "群里红点消了，人已经从群里滑走"
  },
  {
    "start": 12.347,
    "end": 15.483,
    "text": "顶上那条还钉着，没有人真正点开"
  },
  {
    "start": 15.483,
    "end": 18.361,
    "text": "别把钉过一次，当成他看过一遍"
  },
  {
    "start": 18.361,
    "end": 21.191,
    "text": "通知送到了，不等于他看完了"
  },
  {
    "start": 21.191,
    "end": 24.434,
    "text": "他看见置顶两个字，手已经往下划"
  },
  {
    "start": 24.434,
    "end": 27.111,
    "text": "要他看，第一句就写清楚动作"
  },
  {
    "start": 27.111,
    "end": 30.012,
    "text": "谁来做、做什么、做到哪一天"
  },
  {
    "start": 30.012,
    "end": 32.406,
    "text": "别只丢一句请看置顶"
  },
  {
    "start": 32.406,
    "end": 34.965,
    "text": "置顶旁边再点一次具体的名"
  },
  {
    "start": 34.965,
    "end": 37.453,
    "text": "点一次名，比再钉一次管用"
  },
  {
    "start": 37.453,
    "end": 40.566,
    "text": "写完自己检查一遍，别只靠置顶"
  },
  {
    "start": 40.566,
    "end": 42.63,
    "text": "钉子就算钉得再高"
  },
  {
    "start": 42.63,
    "end": 44.953,
    "text": "没有动作，他还是不会看"
  },
  {
    "start": 44.953,
    "end": 47.568,
    "text": "先写动作，再决定钉不钉"
  }
]
