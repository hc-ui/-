[
  {
    "start": 0.0,
    "end": 1.252,
    "text": "大家好"
  },
  {
    "start": 1.252,
    "end": 3.123,
    "text": "评审变成找茬会"
  },
  {
    "start": 3.123,
    "end": 6.988,
    "text": "本来该看能不能过，却在抠标点、抠用词"
  },
  {
    "start": 6.988,
    "end": 10.519,
    "text": "一条能过的方案，被十条口味意见按住"
  },
  {
    "start": 10.519,
    "end": 14.289,
    "text": "不是意见太多，是评审忘了自己在审什么"
  },
  {
    "start": 14.289,
    "end": 18.31,
    "text": "找茬会只证明谁更细，不证明方案能不能走"
  },
  {
    "start": 18.31,
    "end": 22.128,
    "text": "被找茬的人下次少讲，问题被藏进抽屉"
  },
  {
    "start": 22.128,
    "end": 24.855,
    "text": "评审该盯风险，不该盯口味"
  },
  {
    "start": 24.855,
    "end": 27.166,
    "text": "先问这一条拦不拦过"
  },
  {
    "start": 27.166,
    "end": 29.499,
    "text": "拦过的写成必须改"
  },
  {
    "start": 29.499,
    "end": 32.886,
    "text": "口味写成可选，别和风险绑在一起"
  },
  {
    "start": 32.886,
    "end": 36.823,
    "text": "对照一下：找茬是把人按住，评审是把路铺开"
  },
  {
    "start": 36.823,
    "end": 39.396,
    "text": "会前先写三条必须看的点"
  },
  {
    "start": 39.396,
    "end": 42.735,
    "text": "会上只打这三条，其余会后纸条"
  },
  {
    "start": 42.735,
    "end": 45.919,
    "text": "散会时只带走必须改和谁改"
  },
  {
    "start": 45.919,
    "end": 48.783,
    "text": "评审要能过，不要变成找茬会"
  }
]
