    "text": "本子在抽屉里，字不在纸上"
  },
  {
    "start": 9.552,
    "end": 11.807,
    "text": "夜里出事，只能猜"
  },
  {
    "start": 11.807,
    "end": 14.307,
    "text": "交接变成口头传说"
  },
  {
    "start": 14.307,
    "end": 16.209,
    "text": "第一晚就踩坑"
  },
  {
    "start": 16.209,
    "end": 18.492,
    "text": "报警不知道打给谁"
  },
  {
    "start": 18.492,
    "end": 21.372,
    "text": "停机步骤只在某个人脑子里"
  },
  {
    "start": 21.372,
    "end": 24.117,
    "text": "人一不在，整晚就悬着"
  },
  {
    "start": 24.117,
    "end": 26.168,
    "text": "接班先补三页"
  },
  {
    "start": 26.168,
    "end": 28.111,
    "text": "第一页写谁接"
  },
  {
    "start": 28.111,
    "end": 29.986,
    "text": "第二页写怎么停"
  },
  {
    "start": 29.986,
    "end": 32.12,
    "text": "第三页写打给谁"
  },
  {
    "start": 32.12,
    "end": 35.53,
    "text": "手册要能照着做，不是封面好看"
  },
  {
    "start": 35.53,
    "end": 38.247,
    "text": "写完交接，把空页补上"
  },
  {
    "start": 38.247,
    "end": 41.544,
    "text": "空手册的值班，请当成没值"
  }
