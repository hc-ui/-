[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 3.066,
    "text": "先给结论再展开"
  },
  {
    "start": 3.066,
    "end": 5.778,
    "text": "背景铺完，结论还在最后一句"
  },
  {
    "start": 5.778,
    "end": 7.37,
    "text": "听众已经走了"
  },
  {
    "start": 7.37,
    "end": 10.083,
    "text": "能带走的那句，要放在最前面"
  },
  {
    "start": 10.083,
    "end": 12.642,
    "text": "整段口播，结论要在头上"
  },
  {
    "start": 12.642,
    "end": 15.283,
    "text": "先铺背景的稿，听起来认真"
  },
  {
    "start": 15.283,
    "end": 16.84,
    "text": "人却留不住"
  },
  {
    "start": 16.84,
    "end": 18.88,
    "text": "你还在交代从哪来"
  },
  {
    "start": 18.88,
    "end": 20.307,
    "text": "他已经滑走"
  },
  {
    "start": 20.307,
    "end": 23.031,
    "text": "结论埋在尾巴，前面全是垫"
  },
  {
    "start": 23.031,
    "end": 25.507,
    "text": "先把能复述的那句扔出去"
  },
  {
    "start": 25.507,
    "end": 28.078,
    "text": "再补为什么，再补从哪来"
  },
  {
    "start": 28.078,
    "end": 30.779,
    "text": "为什么叠在后面，不抢第一屏"
  },
  {
    "start": 30.779,
    "end": 33.526,
    "text": "写完口播，把结论拎到开头"
  },
  {
    "start": 33.526,
    "end": 36.392,
    "text": "对照一下，结论在尾还是在头"
  },
  {
    "start": 36.392,
    "end": 39.257,
    "text": "长铺垫先划掉，结论先落地"
  },
  {
    "start": 39.257,
    "end": 41.88,
    "text": "先给能带走的那句，再展开"
  }
]
