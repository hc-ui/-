{
  "duration": 49.08,
  "duration_zh": "49.1秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 4.222,
      "text": "整数转换套输入会炸，先包一层"
    },
    {
      "start": 4.222,
      "end": 8.019,
      "text": "不是菜单坏了，是生输入直接转成了整数"
    },
    {
      "start": 8.019,
      "end": 11.132,
      "text": "键盘敲一个甲，程序当场炸掉"
    },
    {
      "start": 11.132,
      "end": 13.149,
      "text": "空串和字母都会炸"
    },
    {
      "start": 13.149,
      "end": 16.344,
      "text": "只打这一个炸点，异常整章先放下"
    },
    {
      "start": 16.344,
      "end": 19.198,
      "text": "先把输入包住，再拿去当选项"
    },
    {
      "start": 19.198,
      "end": 22.229,
      "text": "包一层，就是先收字，再认数字"
    },
    {
      "start": 22.229,
      "end": 25.177,
      "text": "认不出来就重问，别让程序死掉"
    },
    {
      "start": 25.177,
      "end": 27.417,
      "text": "认出来了，再交给菜单"
    },
    {
      "start": 27.417,
      "end": 30.79,
      "text": "选项一吃到的，必须是过关后的数字"
    },
    {
      "start": 30.79,
      "end": 33.267,
      "text": "没过关的甲，不准进分支"
    },
    {
      "start": 33.267,
      "end": 34.976,
      "text": "对照只打这一点"
    },
    {
      "start": 34.976,
      "end": 37.241,
      "text": "先包一层，再当选项"
    },
    {
      "start": 37.241,
      "end": 40.342,
      "text": "写菜单之前，先问输入过没过关"
    },
    {
      "start": 40.342,
      "end": 42.842,
      "text": "一敲甲就炸，是因为没包"
    },
    {
      "start": 42.842,
      "end": 46.203,
      "text": "包过一层再进选项，菜单才能站住"
    },
    {
      "start": 46.203,
      "end": 49.08,
      "text": "没包一层的输入，请当成会炸"
    }
  ]
}
