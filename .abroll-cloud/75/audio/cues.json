[
  {
    "start": 0.0,
    "end": 1.265,
    "text": "大家好"
  },
  {
    "start": 1.265,
    "end": 5.138,
    "text": "成绩册看起来像一张表，其实是两层抽屉"
  },
  {
    "start": 5.138,
    "end": 8.862,
    "text": "一层抽屉硬塞两层标签，门就关不上"
  },
  {
    "start": 8.862,
    "end": 12.683,
    "text": "左边写名字当钥匙，右边再塞一本小字典"
  },
  {
    "start": 12.683,
    "end": 16.89,
    "text": "只开一层，拿到的是整本小册子，不是那个数"
  },
  {
    "start": 16.89,
    "end": 20.179,
    "text": "名字是第一层，科目才是第二层"
  },
  {
    "start": 20.179,
    "end": 23.165,
    "text": "名字指向科目，科目指向分数"
  },
  {
    "start": 23.165,
    "end": 26.369,
    "text": "要拿分数，得先开名字，再开科目"
  },
  {
    "start": 26.369,
    "end": 29.512,
    "text": "库存也一样，名字在外，库存在里"
  },
  {
    "start": 29.512,
    "end": 32.583,
    "text": "两层中括号，才能取到里面的字段"
  },
  {
    "start": 32.583,
    "end": 35.86,
    "text": "别把里面那一整层，当成一个值来用"
  },
  {
    "start": 35.86,
    "end": 39.546,
    "text": "外层只认名字，里层才认科目和库存"
  },
  {
    "start": 39.546,
    "end": 43.125,
    "text": "对照只打这一点：两层走，一层走不通"
  },
  {
    "start": 43.125,
    "end": 45.906,
    "text": "写字典之前，先数它有几层"
  },
  {
    "start": 45.906,
    "end": 48.782,
    "text": "两层就两层走，别当一层用"
  }
]
