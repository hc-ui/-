{
  "duration": 46.848,
  "duration_zh": "46.8秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 3.479,
      "text": "零知识秒懂的，排前面"
    },
    {
      "start": 3.479,
      "end": 6.604,
      "text": "上线顺序的第一原则，不是好不好画"
    },
    {
      "start": 6.604,
      "end": 8.833,
      "text": "是荒谬感的理解门槛"
    },
    {
      "start": 8.833,
      "end": 11.415,
      "text": "零知识也能秒懂的，先上"
    },
    {
      "start": 11.415,
      "end": 15.318,
      "text": "先得关心某个物理量，才能感到反常的，往后放"
    },
    {
      "start": 15.318,
      "end": 17.807,
      "text": "第二原则，才是生成难度"
    },
    {
      "start": 17.807,
      "end": 20.13,
      "text": "难度低，不等于门槛低"
    },
    {
      "start": 20.13,
      "end": 23.314,
      "text": "门槛低的，不用预习就能感到不对"
    },
    {
      "start": 23.314,
      "end": 26.981,
      "text": "门槛高的，得先关心那个量才看得出反常"
    },
    {
      "start": 26.981,
      "end": 29.127,
      "text": "两根轴别叠成一根"
    },
    {
      "start": 29.127,
      "end": 32.134,
      "text": "先按门槛排，再按好不好画排"
    },
    {
      "start": 32.134,
      "end": 33.856,
      "text": "秒懂的进前排"
    },
    {
      "start": 33.856,
      "end": 36.226,
      "text": "先得关心物理量的往后站"
    },
    {
      "start": 36.226,
      "end": 39.517,
      "text": "开局先立完播，硬核等可信度立住"
    },
    {
      "start": 39.517,
      "end": 42.335,
      "text": "排序先问门槛，再问好不好画"
    },
    {
      "start": 42.335,
      "end": 44.505,
      "text": "零知识秒懂的排前面"
    },
    {
      "start": 44.505,
      "end": 46.848,
      "text": "别让门槛高的抢开局"
    }
  ]
}
