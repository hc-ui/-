{
  "duration": 44.28,
  "duration_zh": "44.3秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 3.007,
      "text": "先问有没有人想看"
    },
    {
      "start": 3.007,
      "end": 5.401,
      "text": "不是先问模型能不能做对"
    },
    {
      "start": 5.401,
      "end": 9.045,
      "text": "纯画面验证失败以后，最稳的方向被否了"
    },
    {
      "start": 9.045,
      "end": 11.226,
      "text": "它是壁纸，不是片子"
    },
    {
      "start": 11.226,
      "end": 13.762,
      "text": "没人物，没欲望，没失败"
    },
    {
      "start": 13.762,
      "end": 15.46,
      "text": "第一次看会哦一声"
    },
    {
      "start": 15.46,
      "end": 17.653,
      "text": "第三次手指就滑走"
    },
    {
      "start": 17.653,
      "end": 20.377,
      "text": "能做对的空镜，也没人停下来"
    },
    {
      "start": 20.377,
      "end": 23.703,
      "text": "顺序反了，就会反复推出零欲望方案"
    },
    {
      "start": 23.703,
      "end": 26.097,
      "text": "第一步，先问有没有人想看"
    },
    {
      "start": 26.097,
      "end": 28.833,
      "text": "第二步，再问模型能不能做对"
    },
    {
      "start": 28.833,
      "end": 31.639,
      "text": "有人看的欲望，排在能做对前面"
    },
    {
      "start": 31.639,
      "end": 34.092,
      "text": "没有人物，就没有人跟着走"
    },
    {
      "start": 34.092,
      "end": 36.91,
      "text": "没有失败，就没有人想看结局"
    },
    {
      "start": 36.91,
      "end": 39.446,
      "text": "技术上漂亮，情感上为零"
    },
    {
      "start": 39.446,
      "end": 41.38,
      "text": "先欲望，再模型"
    },
    {
      "start": 41.38,
      "end": 44.28,
      "text": "没人想看的方向，请当成没立"
    }
  ]
}
