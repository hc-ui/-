[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 3.573,
    "text": "开学先认领体力型杂务"
  },
  {
    "start": 3.573,
    "end": 6.227,
    "text": "不是等人派活，是自己举手"
  },
  {
    "start": 6.227,
    "end": 9.127,
    "text": "工位卫生值日，仪器例行维护"
  },
  {
    "start": 9.127,
    "end": 12.075,
    "text": "收发组里快递，学院盖章跑腿"
  },
  {
    "start": 12.075,
    "end": 15.189,
    "text": "这四样边界清楚，做完就有终点"
  },
  {
    "start": 15.189,
    "end": 17.535,
    "text": "主动申请，把位置占住"
  },
  {
    "start": 17.535,
    "end": 20.236,
    "text": "占住的是体力活，不是账本"
  },
  {
    "start": 20.236,
    "end": 22.347,
    "text": "卫生清单勾完就停"
  },
  {
    "start": 22.347,
    "end": 24.233,
    "text": "快递送到手就交"
  },
  {
    "start": 24.233,
    "end": 26.415,
    "text": "章盖完，人立刻回来"
  },
  {
    "start": 26.415,
    "end": 28.95,
    "text": "别把杂务认领成长期岗位"
  },
  {
    "start": 28.95,
    "end": 31.392,
    "text": "做完即止，不要反复纠缠"
  },
  {
    "start": 31.392,
    "end": 33.231,
    "text": "有终点的活才接"
  },
  {
    "start": 33.231,
    "end": 35.059,
    "text": "认领之前先问一句"
  },
  {
    "start": 35.059,
    "end": 36.792,
    "text": "做完有没有终点"
  },
  {
    "start": 36.792,
    "end": 38.726,
    "text": "有终点，就举手"
  },
  {
    "start": 38.726,
    "end": 41.208,
    "text": "体力型杂务，请主动认领"
  }
