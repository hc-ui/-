[
  {
    "start": 0.0,
    "end": 1.338,
    "text": "大家好"
  },
  {
    "start": 1.338,
    "end": 3.52,
    "text": "请假别空手交假条"
  },
  {
    "start": 3.52,
    "end": 5.816,
    "text": "随假带上两套方案"
  },
  {
    "start": 5.816,
    "end": 8.176,
    "text": "假条下面钉着汇报稿"
  },
  {
    "start": 8.176,
    "end": 11.122,
    "text": "导师要的是能选，不是听你解释"
  },
  {
    "start": 11.122,
    "end": 14.094,
    "text": "只交一句对不起，他只能驳"
  },
  {
    "start": 14.094,
    "end": 17.781,
    "text": "方案一，组会开头先汇报，再去上课"
  },
  {
    "start": 17.781,
    "end": 21.25,
    "text": "方案二，课后补做，或者下次补上"
  },
  {
    "start": 21.25,
    "end": 23.89,
    "text": "两张卡并列，让他勾一张"
  },
  {
    "start": 23.89,
    "end": 25.957,
    "text": "别只写主观理由"
  },
  {
    "start": 25.957,
    "end": 29.362,
    "text": "培养方案是刚性的，把冲突写清楚"
  },
  {
    "start": 29.362,
    "end": 32.806,
    "text": "不念话术全文，只交结构和选项"
  },
  {
    "start": 32.806,
    "end": 35.74,
    "text": "空手请假，等于把决定扔回去"
  },
  {
    "start": 35.74,
    "end": 38.444,
    "text": "附件先交上，人再离开"
  },
  {
    "start": 38.444,
    "end": 41.033,
    "text": "他勾哪张，你就按哪张走"
  },
  {
    "start": 41.033,
    "end": 43.632,
    "text": "带两方案，才算请过假"
  }
]
