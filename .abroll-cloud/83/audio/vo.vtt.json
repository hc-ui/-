[
  {
    "start": 0.0,
    "end": 1.288,
    "text": "大家好"
  },
  {
    "start": 1.288,
    "end": 3.37,
    "text": "旧方案套不上新问题"
  },
  {
    "start": 3.37,
    "end": 7.218,
    "text": "去年那套能跑的办法，拿到今年就对不上"
  },
  {
    "start": 7.218,
    "end": 10.208,
    "text": "问题已经换了皮，模板还是旧的"
  },
  {
    "start": 10.208,
    "end": 13.309,
    "text": "人还在按旧步骤往新题上套"
  },
  {
    "start": 13.309,
    "end": 15.637,
    "text": "硬套上去，缝会裂开"
  },
  {
    "start": 15.637,
    "end": 18.297,
    "text": "不是执行不力，是尺寸不对"
  },
  {
    "start": 18.297,
    "end": 21.238,
    "text": "旧约束已经不在了，你还当它在"
  },
  {
    "start": 21.238,
    "end": 24.804,
    "text": "先别急着改旧稿，先写下这次新在哪"
  },
  {
    "start": 24.804,
    "end": 28.15,
    "text": "边界变了，约束变了，目标也变了"
  },
  {
    "start": 28.15,
    "end": 30.919,
    "text": "能留的留下，对不上的重写"
  },
  {
    "start": 30.919,
    "end": 33.272,
    "text": "别把旧流程图硬拉长"
  },
  {
    "start": 33.272,
    "end": 36.103,
    "text": "别把旧提示词再改两个词"
  },
  {
    "start": 36.103,
    "end": 38.787,
    "text": "别拿上学期的课表套这学期"
  },
  {
    "start": 38.787,
    "end": 41.887,
    "text": "对照卡摊开，新条件对旧步骤"
  },
  {
    "start": 41.887,
    "end": 43.897,
    "text": "对得上的步骤才复用"
  },
  {
    "start": 43.897,
    "end": 46.238,
    "text": "套不上的地方立刻停手"
  },
  {
    "start": 46.238,
    "end": 49.2,
    "text": "新问题先量尺寸，再裁新布"
  }
]
