[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 3.62,
    "text": "接口改了，只口头说一声"
  },
  {
    "start": 3.62,
    "end": 6.899,
    "text": "字段名换了，调用方还按旧字段打"
  },
  {
    "start": 6.899,
    "end": 10.083,
    "text": "站会提一句，文档还是上周的路径"
  },
  {
    "start": 10.083,
    "end": 13.608,
    "text": "你以为全组听见了，一半人还在打旧地址"
  },
  {
    "start": 13.608,
    "end": 17.134,
    "text": "联调当天才炸，双方都说自己没错"
  },
  {
    "start": 17.134,
    "end": 19.776,
    "text": "口头说一声，不是接口变更"
  },
  {
    "start": 19.776,
    "end": 24.316,
    "text": "变更要落三处：改了什么，谁受影响，从哪版生效"
  },
  {
    "start": 24.316,
    "end": 26.593,
    "text": "路径换了就写新路径"
  },
  {
    "start": 26.593,
    "end": 29.175,
    "text": "字段改名就写新旧对照"
  },
  {
    "start": 29.175,
    "end": 33.325,
    "text": "没写成字，调用方按旧契约来，算这次没改完"
  },
  {
    "start": 33.325,
    "end": 36.05,
    "text": "别把接口变更，只留在嘴里"
  },
  {
    "start": 36.05,
    "end": 37.96,
    "text": "先写下，再上线"
  },
  {
    "start": 37.96,
    "end": 40.389,
    "text": "嘴里的变更，联调接不住"
  },
  {
    "start": 40.389,
    "end": 42.819,
    "text": "写成字，才算改过接口"
  },
  {
    "start": 42.819,
    "end": 45.456,
    "text": "口头说一声，请当成没改"
  }
]
