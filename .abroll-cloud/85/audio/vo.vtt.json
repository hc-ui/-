[
  {
    "start": 0.0,
    "end": 1.338,
    "text": "大家好"
  },
  {
    "start": 1.338,
    "end": 3.469,
    "text": "毕业底线就三件套"
  },
  {
    "start": 3.469,
    "end": 7.041,
    "text": "不是医学顶刊，也不是把湿实验扛完"
  },
  {
    "start": 7.041,
    "end": 9.133,
    "text": "第一件，按时开题"
  },
  {
    "start": 9.133,
    "end": 12.602,
    "text": "第二件，工程型学位论文过盲审"
  },
  {
    "start": 12.602,
    "end": 15.434,
    "text": "第三件，挂上专利或论文"
  },
  {
    "start": 15.434,
    "end": 17.819,
    "text": "学院只认这三张卡"
  },
  {
    "start": 17.819,
    "end": 20.982,
    "text": "三件打满，导师按流程签字"
  },
  {
    "start": 20.982,
    "end": 23.903,
    "text": "别拿博士的顶刊当自己的线"
  },
  {
    "start": 23.903,
    "end": 26.824,
    "text": "硕士过关，是最低标准打满"
  },
  {
    "start": 26.824,
    "end": 29.885,
    "text": "开题拖过窗口，后面全堵死"
  },
  {
    "start": 29.885,
    "end": 33.163,
    "text": "论文要过盲审，不是写得漂亮就行"
  },
  {
    "start": 33.163,
    "end": 36.467,
    "text": "专利或论文，名字挂上去才算数"
  },
  {
    "start": 36.467,
    "end": 39.005,
    "text": "缺一件，流程停在门口"
  },
  {
    "start": 39.005,
    "end": 41.543,
    "text": "先钉这三件，再谈别的"
  },
  {
    "start": 41.543,
    "end": 44.256,
    "text": "底线打满，毕业才走得动"
  }
]
