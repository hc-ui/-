[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 3.726,
    "text": "成绩加完了，关程序就没了"
  },
  {
    "start": 3.726,
    "end": 7.123,
    "text": "不是菜单坏了，是成绩只活在内存里"
  },
  {
    "start": 7.123,
    "end": 9.882,
    "text": "内存里的本，窗口一关就散"
  },
  {
    "start": 9.882,
    "end": 12.571,
    "text": "不是点一次菜单被揉成白纸"
  },
  {
    "start": 12.571,
    "end": 15.613,
    "text": "是整本程序关了，成绩才散掉"
  },
  {
    "start": 15.613,
    "end": 19.21,
    "text": "只打这一个过夜点，循环出生地先放下"
  },
  {
    "start": 19.21,
    "end": 21.899,
    "text": "退出前先把成绩写到盘上"
  },
  {
    "start": 21.899,
    "end": 24.682,
    "text": "下次打开，先从盘上读回来"
  },
  {
    "start": 24.682,
    "end": 28.019,
    "text": "打开的时候先读，退出的时候先写"
  },
  {
    "start": 28.019,
    "end": 30.377,
    "text": "盘上有本，关了还能回来"
  },
  {
    "start": 30.377,
    "end": 32.736,
    "text": "内存里的本，关了就没了"
  },
  {
    "start": 32.736,
    "end": 34.446,
    "text": "对照只打这一点"
  },
  {
    "start": 34.446,
    "end": 37.123,
    "text": "先把成绩存盘，再关程序"
  },
  {
    "start": 37.123,
    "end": 40.531,
    "text": "写进菜单之前，先问成绩落没落盘"
  },
  {
    "start": 40.531,
    "end": 43.55,
    "text": "加进去了却没落盘，等于没记下"
  },
  {
    "start": 43.55,
    "end": 46.509,
    "text": "落了盘再退出，成绩才能过夜"
  },
  {
    "start": 46.509,
    "end": 49.392,
    "text": "没存盘的成绩，请当成会丢"
  }
]
