    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 3.514,
    "text": "大案例先拆到能退出"
  },
  {
    "start": 3.514,
    "end": 7.017,
    "text": "不是缺语法，是增列统计焊死了退门"
  },
  {
    "start": 7.017,
    "end": 10.578,
    "text": "一上来四件事一起上，菜单卡死出不去"
  },
  {
    "start": 10.578,
    "end": 13.196,
    "text": "退门焊死，程序就停不住"
  },
  {
    "start": 13.196,
    "end": 15.825,
    "text": "先让退出通，别急着加功能"
  },
  {
    "start": 15.825,
    "end": 17.972,
    "text": "退出通了，才算有门"
  },
  {
    "start": 17.972,
    "end": 20.649,
    "text": "门没开，增和列都进不去"
  },
  {
    "start": 20.649,
    "end": 23.88,
    "text": "再做增加和列出，成绩才能进出"
  },
  {
    "start": 23.88,
    "end": 27.512,
    "text": "最后才做统计，最高最低平均往后排"
  },
  {
    "start": 27.512,
    "end": 29.976,
    "text": "先活下来，再往里装东西"
  },
  {
    "start": 29.976,
    "end": 31.686,
    "text": "对照只打这一点"
  },
  {
    "start": 31.686,
    "end": 34.553,
    "text": "先拆到能退出，再增和列出"
  },
  {
    "start": 34.553,
    "end": 37.453,
    "text": "统计是第三步，不是开工第一枪"
  },
  {
    "start": 37.453,
    "end": 39.8,
    "text": "整坨焊死，一改就炸"
  },
  {
    "start": 39.8,
    "end": 42.311,
    "text": "拆到能退出，才能停得住"
  },
  {
    "start": 42.311,
    "end": 44.882,
    "text": "大案例先拆开，先让退出通"
  },
  {
    "start": 44.882,
    "end": 47.496,
    "text": "退出通了，这盘才算站住"
  }
