{
  "duration": 44.424,
  "duration_zh": "44.4秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 3.455,
      "text": "学术放养，工位收紧"
    },
    {
      "start": 3.455,
      "end": 5.731,
      "text": "题怎么推，他很少下场"
    },
    {
      "start": 5.731,
      "end": 8.974,
      "text": "算法推导他不改，控制回路他不盯"
    },
    {
      "start": 8.974,
      "end": 11.309,
      "text": "底层代码，他基本不碰"
    },
    {
      "start": 11.309,
      "end": 15.024,
      "text": "重大项目靠博士扛，硕士细节自己消化"
    },
    {
      "start": 15.024,
      "end": 17.276,
      "text": "别把放养当成没人管"
    },
    {
      "start": 17.276,
      "end": 19.422,
      "text": "椅子空着，才是大事"
    },
    {
      "start": 19.422,
      "end": 22.335,
      "text": "工位要人在，实验室要看得见"
    },
    {
      "start": 22.335,
      "end": 25.755,
      "text": "通知说不准哪天来，周末也可能叫人"
    },
    {
      "start": 25.755,
      "end": 28.62,
      "text": "假日前夕，临时会说开就开"
    },
    {
      "start": 28.62,
      "end": 31.781,
      "text": "他抓的是物理在场，不是推导对不对"
    },
    {
      "start": 31.781,
      "end": 34.434,
      "text": "宏观讲得多，比喻听完就散"
    },
    {
      "start": 34.434,
      "end": 37.594,
      "text": "别等学业指引，也别等情绪支持"
    },
    {
      "start": 37.594,
      "end": 39.552,
      "text": "职业契约摆正就行"
    },
    {
      "start": 39.552,
      "end": 42.311,
      "text": "放养的是学术，收紧的是工位"
    },
    {
      "start": 42.311,
      "end": 44.424,
      "text": "人坐住，题自己啃"
    }
  ]
}
