[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 3.691,
    "text": "本地实习，等成果锁定"
  },
  {
    "start": 3.691,
    "end": 6.108,
    "text": "不是现在就去问本地岗位"
  },
  {
    "start": 6.108,
    "end": 9.717,
    "text": "专利或论文初稿没锁，先别探本地岗"
  },
  {
    "start": 9.717,
    "end": 11.887,
    "text": "研一现在去问，问早了"
  },
  {
    "start": 11.887,
    "end": 15.106,
    "text": "成果没盖章，人一挪，答辩就悬"
  },
  {
    "start": 15.106,
    "end": 17.17,
    "text": "先把毕业成果锁死"
  },
  {
    "start": 17.17,
    "end": 20.2,
    "text": "专利交出去，或者论文初稿定稿"
  },
  {
    "start": 20.2,
    "end": 22.783,
    "text": "锁死了，才有资格谈本地"
  },
  {
    "start": 22.783,
    "end": 25.377,
    "text": "时间窗在研二下，或者研三"
  },
  {
    "start": 25.377,
    "end": 29.281,
    "text": "合肥本地兼职，阶段性离校，都等这一步"
  },
  {
    "start": 29.281,
    "end": 32.394,
    "text": "杂活还握在手里，本地岗先灰掉"
  },
  {
    "start": 32.394,
    "end": 35.307,
    "text": "交给新一届，交接清单勾完"
  },
  {
    "start": 35.307,
    "end": 37.63,
    "text": "交接没写清，人别挪"
  },
  {
    "start": 37.63,
    "end": 40.224,
    "text": "没锁之前，本地实习先停"
  },
  {
    "start": 40.224,
    "end": 42.7,
    "text": "锁了，交了，再探本地"
  },
  {
    "start": 42.7,
    "end": 45.071,
    "text": "成果先锁，杂活先交"
  },
  {
    "start": 45.071,
    "end": 47.616,
    "text": "本地实习，等成果锁定"
  }
]
