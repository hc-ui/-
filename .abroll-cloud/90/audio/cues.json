[
  {
    "start": 0.0,
    "end": 1.288,
    "text": "大家好"
  },
  {
    "start": 1.288,
    "end": 4.461,
    "text": "课题做完，别把领域身份一起背走"
  },
  {
    "start": 4.461,
    "end": 7.231,
    "text": "从课题里抽可带走的能力"
  },
  {
    "start": 7.231,
    "end": 10.27,
    "text": "留下的是场景，抽走的是方法"
  },
  {
    "start": 10.27,
    "end": 14.179,
    "text": "温控台前，抽闭环和建模，不是养细胞"
  },
  {
    "start": 14.179,
    "end": 18.321,
    "text": "采集脚本里，抽传感器进代码，不是试剂名"
  },
  {
    "start": 18.321,
    "end": 21.348,
    "text": "别把整段湿实验写进下一份工"
  },
  {
    "start": 21.348,
    "end": 25.478,
    "text": "简历写会建回路、会处理数据，别写我做过生医"
  },
  {
    "start": 25.478,
    "end": 28.861,
    "text": "换组换厂还能接着用，才叫抽走了"
  },
  {
    "start": 28.861,
    "end": 34.387,
    "text": "列一张可迁移清单：处理、控制、建模、采集、自动化"
  },
  {
    "start": 34.387,
    "end": 38.236,
    "text": "每做完一块，改成下一份工也能用的句子"
  },
  {
    "start": 38.236,
    "end": 40.539,
    "text": "领域名可以留在论文里"
  },
  {
    "start": 40.539,
    "end": 42.966,
    "text": "能力名要能单独站得住"
  },
  {
    "start": 42.966,
    "end": 45.245,
    "text": "课题是矿，不是籍贯"
  },
  {
    "start": 45.245,
    "end": 47.206,
    "text": "矿留下，件带走"
  },
  {
    "start": 47.206,
    "end": 49.992,
    "text": "抽走可迁移件，人才能走"
  }
]
