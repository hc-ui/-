[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 5.0,
    "text": "课题可以偏生医，就业栈别焊死在生医上"
  },
  {
    "start": 5.0,
    "end": 8.785,
    "text": "长期栈要指向能换房间的能力，不是培养箱"
  },
  {
    "start": 8.785,
    "end": 12.04,
    "text": "下一份工的入口，别只留给体外诊断"
  },
  {
    "start": 12.04,
    "end": 16.097,
    "text": "实习只投生仪厂，等于把栈焊进一间实验室"
  },
  {
    "start": 16.097,
    "end": 19.351,
    "text": "选修只抱生医仪器，别的房间进不去"
  },
  {
    "start": 19.351,
    "end": 22.866,
    "text": "夜读只翻细胞手册，栈就会跟着湿台走"
  },
  {
    "start": 22.866,
    "end": 25.519,
    "text": "岗位名里没有细胞，也可以投"
  },
  {
    "start": 25.519,
    "end": 29.587,
    "text": "控制、机器人、系统，才是栈该指向的方向"
  },
  {
    "start": 29.587,
    "end": 32.972,
    "text": "生医是现在的房间，不是住一辈子的城"
  },
  {
    "start": 32.972,
    "end": 35.896,
    "text": "课题交差可以窄，栈不要跟着窄"
  },
  {
    "start": 35.896,
    "end": 38.738,
    "text": "招人问你会什么，别先报应用名"
  },
  {
    "start": 38.738,
    "end": 41.026,
    "text": "先报你会把系统稳住"
  },
  {
    "start": 41.026,
    "end": 43.101,
    "text": "别报待过哪类实验室"
  },
  {
    "start": 43.101,
    "end": 46.604,
    "text": "焊死在生医上，下一扇门会自己关上"
  },
  {
    "start": 46.604,
    "end": 49.632,
    "text": "栈指向房间外面，人才能走出去"
  }
]
