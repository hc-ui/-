[
  {
    "start": 0.0,
    "end": 1.338,
    "text": "大家好"
  },
  {
    "start": 1.338,
    "end": 3.571,
    "text": "方向别靠空想拍板"
  },
  {
    "start": 3.571,
    "end": 7.219,
    "text": "研一结束前，用项目判断往哪边走"
  },
  {
    "start": 7.219,
    "end": 12.653,
    "text": "三条候选摆在桌上：机器人算法、具身智能、智能体工程"
  },
  {
    "start": 12.653,
    "end": 15.906,
    "text": "看再多介绍，也只是想象里的顺"
  },
  {
    "start": 15.906,
    "end": 19.324,
    "text": "课听完、视频刷完，方向还是空的"
  },
  {
    "start": 19.324,
    "end": 22.628,
    "text": "真正能判的，是你亲手做完的那一块"
  },
  {
    "start": 22.628,
    "end": 25.485,
    "text": "先交一个能跑的智能体小件"
  },
  {
    "start": 25.485,
    "end": 28.304,
    "text": "再交一个能动的机器人小件"
  },
  {
    "start": 28.304,
    "end": 31.339,
    "text": "两条都试过，取舍才有依据"
  },
  {
    "start": 31.339,
    "end": 33.98,
    "text": "做完才知道，手更熟哪条"
  },
  {
    "start": 33.98,
    "end": 37.538,
    "text": "哪条做完还想再做，哪条才算方向"
  },
  {
    "start": 37.538,
    "end": 39.63,
    "text": "别等研二才开始试"
  },
  {
    "start": 39.63,
    "end": 42.207,
    "text": "窗口就在研一结束前"
  },
  {
    "start": 42.207,
    "end": 44.388,
    "text": "项目是秤，不是海报"
  },
  {
    "start": 44.388,
    "end": 47.112,
    "text": "秤过了，方向才立得住"
  }
]
