[
  {
    "start": 0.0,
    "end": 1.338,
    "text": "大家好"
  },
  {
    "start": 1.338,
    "end": 3.661,
    "text": "别在标题里堆感叹号"
  },
  {
    "start": 3.661,
    "end": 7.513,
    "text": "三个感叹号叠上去，可信度当场掉一截"
  },
  {
    "start": 7.513,
    "end": 10.306,
    "text": "它不像强调，像在喊你买"
  },
  {
    "start": 10.306,
    "end": 12.13,
    "text": "标题只留事实"
  },
  {
    "start": 12.13,
    "end": 14.668,
    "text": "感叹号越多，越像叫卖"
  },
  {
    "start": 14.668,
    "end": 18.189,
    "text": "错的写法，搞定了后面三个感叹号"
  },
  {
    "start": 18.189,
    "end": 21.237,
    "text": "对的写法，搞定了，句号收住"
  },
  {
    "start": 21.237,
    "end": 24.069,
    "text": "一边像促销，一边像笔记"
  },
  {
    "start": 24.069,
    "end": 25.995,
    "text": "感叹号不是钩子"
  },
  {
    "start": 25.995,
    "end": 28.724,
    "text": "钩子靠事实，不靠感叹号"
  },
  {
    "start": 28.724,
    "end": 31.403,
    "text": "写完标题，先数感叹号"
  },
  {
    "start": 31.403,
    "end": 33.737,
    "text": "超过一个，就全删"
  },
  {
    "start": 33.737,
    "end": 35.969,
    "text": "标点救不了弱标题"
  },
  {
    "start": 35.969,
    "end": 39.962,
    "text": "把感叹号删掉，句子还站得住，才算写完"
  },
  {
    "start": 39.962,
    "end": 42.192,
    "text": "标题里不堆感叹号"
  }
]
