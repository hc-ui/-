[
  {
    "start": 0.0,
    "end": 1.241,
    "text": "大家好"
  },
  {
    "start": 1.241,
    "end": 3.267,
    "text": "学完了，立刻用一次"
  },
  {
    "start": 3.267,
    "end": 6.745,
    "text": "看完教程以为会了，合上书就不会了"
  },
  {
    "start": 6.745,
    "end": 9.623,
    "text": "笔记攒了一堆，手上没留下一次"
  },
  {
    "start": 9.623,
    "end": 12.535,
    "text": "不是没学，是学完没有当场交手"
  },
  {
    "start": 12.535,
    "end": 15.047,
    "text": "教程还摊着，手却空着"
  },
  {
    "start": 15.047,
    "end": 18.243,
    "text": "下一页翻得很快，上一页却带不走"
  },
  {
    "start": 18.243,
    "end": 21.238,
    "text": "合上教程之前，先自己写一遍"
  },
  {
    "start": 21.238,
    "end": 23.219,
    "text": "不看答案，先交一次"
  },
  {
    "start": 23.219,
    "end": 26.285,
    "text": "刚记下一条，立刻拿手头题用一次"
  },
  {
    "start": 26.285,
    "end": 29.41,
    "text": "写错了也算用过，没写才是没学"
  },
  {
    "start": 29.41,
    "end": 31.686,
    "text": "用完这一次，再往下翻"
  },
  {
    "start": 31.686,
    "end": 34.375,
    "text": "看过却没用过，等于没学完"
  },
  {
    "start": 34.375,
    "end": 37.134,
    "text": "笔记不是学会，对照只打这一点"
  },
  {
    "start": 37.134,
    "end": 39.469,
    "text": "先用一次，再记下一页"
  },
  {
    "start": 39.469,
    "end": 42.594,
    "text": "当场交一次手，这一页才算合上"
  },
  {
    "start": 42.594,
    "end": 44.741,
    "text": "用过一次，才算学过"
  },
  {
    "start": 44.741,
    "end": 47.544,
    "text": "没立刻用过的，请当成没学完"
  }
