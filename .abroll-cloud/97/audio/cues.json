    "text": "上线以仓库为准"
  },
  {
    "start": 31.392,
    "end": 33.986,
    "text": "找不到清单，就算没配完"
  },
  {
    "start": 33.986,
    "end": 36.58,
    "text": "找得到、对得上，才叫环境"
  },
  {
    "start": 36.58,
    "end": 38.833,
    "text": "写进仓库，才算改过"
  },
  {
    "start": 38.833,
    "end": 41.439,
    "text": "别把环境变量留在聊天里"
  },
  {
    "start": 41.439,
    "end": 44.136,
    "text": "聊天里的环境，请当成没配"
  }
