{
  "duration": 47.592,
  "duration_zh": "47.6秒",
  "cues": [
    {
      "start": 0.0,
      "end": 1.241,
      "text": "大家好"
    },
    {
      "start": 1.241,
      "end": 3.384,
      "text": "事故复盘只写人锅"
    },
    {
      "start": 3.384,
      "end": 6.439,
      "text": "会开完了，锅也分完了，人就散了"
    },
    {
      "start": 6.439,
      "end": 9.399,
      "text": "名字圈出来，像事情已经结束了"
    },
    {
      "start": 9.399,
      "end": 12.276,
      "text": "点名听着负责，坑还留在原处"
    },
    {
      "start": 12.276,
      "end": 15.378,
      "text": "不是没人负责，是责任只写到人"
    },
    {
      "start": 15.378,
      "end": 18.361,
      "text": "系统允许点错，却没有人去改门"
    },
    {
      "start": 18.361,
      "end": 21.663,
      "text": "告警当时看不见，下次照样看不见"
    },
    {
      "start": 21.663,
      "end": 24.575,
      "text": "复盘要先问机制，再去问名字"
    },
    {
      "start": 24.575,
      "end": 26.639,
      "text": "哪道门当时没有拦住"
    },
    {
      "start": 26.639,
      "end": 29.293,
      "text": "哪条信息当时根本看不见"
    },
    {
      "start": 29.293,
      "end": 32.088,
      "text": "哪条规则还在诱人去走捷径"
    },
    {
      "start": 32.088,
      "end": 35.33,
      "text": "门补上，信息补上，捷径先拆掉"
    },
    {
      "start": 35.33,
      "end": 37.925,
      "text": "对人负责，其实是改机制"
    },
    {
      "start": 37.925,
      "end": 39.906,
      "text": "不是改一圈面子了事"
    },
    {
      "start": 39.906,
      "end": 41.616,
      "text": "对照只打这一点"
    },
    {
      "start": 41.616,
      "end": 44.54,
      "text": "写下名字，不等于这一次复盘结束"
    },
    {
      "start": 44.54,
      "end": 47.592,
      "text": "坑还在原处，请当成还没复完"
    }
  ]
}
